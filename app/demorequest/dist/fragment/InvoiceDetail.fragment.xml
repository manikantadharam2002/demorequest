
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="orderDetailDialog"
        title="{i18n>InvoiceDetails}"
        draggable="true"
        resizable="true"
        contentWidth="80%"
        contentHeight="90%"
        class="sapUiContentPadding"
    >
        <!-- selectedKey="{dialogModel>/PayMethodSelectedKey}" -->

        <f:Form editable="true">
            <f:layout>
                <f:ResponsiveGridLayout
                    labelSpanXL="3"
                    labelSpanL="4"
                    labelSpanM="6"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="0"
                    emptySpanL="0"
                    emptySpanM="0"
                    emptySpanS="0"
                    columnsXL="3"
                    columnsL="3"
                    columnsM="3"
                />
            </f:layout>

            <f:formContainers>

                <!-- Payment Type -->
                <f:FormContainer>
                    <f:formElements>
                        <f:FormElement label="Payment Type">
                            <f:fields>
                                <Select
                                    id="payMethodChangeid"
                                    selectedKey="{dialogModel>/PayType}"
                                    width="100%"
                                    change="onDialogPayTypeChange"
                                >
                                    <core:Item
                                        key="Full"
                                        text="Full"
                                    />
                                    <core:Item
                                        key="Partial"
                                        text="Partial"
                                    />
                                </Select>
                            </f:fields>
                        </f:FormElement>
                    </f:formElements>
                </f:FormContainer>

                <!-- Total Approval Amount -->
                <f:FormContainer>
                    <f:formElements>
                        <f:FormElement label="Total Approval Amt">
                            <f:fields>
                                <Input
                                    id="totalAmountText"
                                    value="{dialogModel>/ApprovalAmount}"
                                    editable="{= ${dialogModel>/PayType} === 'Partial' }"
                                    width="100%"
                                    textAlign="End"
                                    class="sapUiSmallMarginEnd"
                                    valueLiveUpdate="true"
                                    liveChange=".onDialogApprovalAmountChange"
                                    valueState="{dialogModel>/ApprovalAmtState}"
                                    valueStateText="{dialogModel>/ApprovalAmtStateText}"
                                >
                                    <customData>
                                        <core:CustomData
                                            key="field"
                                            value="ApprovalAmount"
                                        />
                                    </customData>
                                </Input>
                            </f:fields>
                        </f:FormElement>
                    </f:formElements>
                </f:FormContainer>

                <!-- Total Outstanding Amount -->
                <f:FormContainer>
                    <f:formElements>
                        <f:FormElement label="Total O/S Amt">
                            <f:fields>
                                <Input
                                    value="{path:'dialogModel>/TotalAmount',formatter:'.formatter.formatAmount'}"
                                    textAlign="End"
                                    width="100%"
                                    editable="false"
                                    class="sapUiSmallMarginEnd"
                                />
                            </f:fields>
                        </f:FormElement>
                    </f:formElements>
                </f:FormContainer>

            </f:formContainers>
        </f:Form>

        <!-- Invoice Details Table -->
        <Table
            id="invoiceTable"
            items="{dialogModel>/Invoices}"
            width="100%"
            growing="true"
        >
            <columns>

                <!-- 1. Category -->
                <Column visible="{projectModel>/IsCategoryVisible}">
                    <header>
                        <Label text="{i18n>Catagory}" />
                    </header>
                </Column>

                <!-- 2. Vendor / Customer Document No -->
                <Column>
                    <header>
                        <Label
                            text="{= ${projectModel>/IsCategoryVisible} ? ${i18n>VenDocumentNo} : ${i18n>CustDocumentNo} }"
                        />
                    </header>
                </Column>

                <!-- 3. Invoice Date -->
                <Column>
                    <header>
                        <Label text="{i18n>InvoiceDate}" />
                    </header>
                </Column>

                <!-- 4. Document Amount -->
                <Column>
                    <header>
                        <Label text="{i18n>DocumentAmount}" />
                    </header>
                </Column>

                <!-- 5. Full Payment -->
                <Column>
                    <header>
                        <Label text="{i18n>FullPayment}" />
                    </header>
                </Column>

                <!-- 6. Approval Amount -->
                <Column>
                    <header>
                        <Label text="{i18n>ApprovalAmount}" />
                    </header>
                </Column>

                <!-- 7. Invoice No -->
                <Column>
                    <header>
                        <Label text="{i18n>InvoiceNo}" />
                    </header>
                </Column>

                <!-- 8. Remark -->
                <Column>
                    <header>
                        <Label text="{i18n>Remark}" />
                    </header>
                </Column>

                <!-- 9. Status -->
                <Column>
                    <header>
                        <Label text="{i18n>Status}" />
                    </header>
                </Column>

            </columns>

            <items>
                <ColumnListItem
                    type="{path:'dialogModel>DocAmt', formatter:'.formatter.formatRowType'}"
                    highlight="{= ${dialogModel>IsFrozen} ? 'Warning' : 'None' }"
                >
                    <cells>

                        <!-- 1. Category -->
                        <Text
                            text="{path:'dialogModel>Category', formatter:'.formatter.formatCategory'}"
                            visible="{projectModel>/IsCategoryVisible}"
                        />

                        <!-- 2. Vendor / Customer Document No -->
                        <Link
                            text="{dialogModel>Docnr}"
                            enabled="{path:'dialogModel>DocAmt', formatter:'.formatter.formatLinkEnabled'}"
                            press=".onPressDocNumber"
                        />

                        <!-- 3. Invoice Date -->
                        <Text
                            text="{path:'dialogModel>Budat',formatter:'.formatter.formatDate'}"
                        />

                        <!-- 4. Document Amount -->
                        <Text
                            text="{parts:['dialogModel>IsFrozen','dialogModel>RemainingAmt','dialogModel>DocAmt'], formatter:'.formatDocAmtDisplay'}"
                        />

                        <!-- 5. Full Payment -->
                        <CheckBox
                            selected="{= parseFloat(${dialogModel>ApprovalAmt}).toFixed(2) === parseFloat(${dialogModel>DocAmt}).toFixed(2) }"
                            enabled="{= !${dialogModel>IsFrozen} }"
                            select=".onFullPaymentSelected"
                        />
                        <!-- 6. Approval Amount -->
                        <Input
                            value="{dialogModel>ApprovalAmt}"
                            editable="{= ${dialogModel>/PayType} === 'Partial' ? !${dialogModel>IsFrozen} : false }"
                            placeholder="Enter amount"
                            liveChange=".onFieldValueChange"
                            valueLiveUpdate="true"
                            valueState="{dialogModel>ApprovalAmtState}"
                            valueStateText="{dialogModel>ApprovalAmtStateText}">
                            <customData>
                                <core:CustomData
                                    key="field"
                                    value="ApprovalAmt"
                                />
                            </customData>
                        </Input>
                        <!-- 7. Invoice No -->
                        <Text
                            text="{dialogModel>Xblnr}"
                        />

                        <!-- 8. Remark -->
                        <Text
                            text="{dialogModel>Sgtxt}"
                        />

                        <!-- 9. Status -->
                        <ObjectStatus
                            text="{dialogModel>PendReqNo}"
                            state="Warning"
                            visible="{dialogModel>IsFrozen}"
                        />

                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <!-- Confirm -->
        <endButton>
            <Button
                text="{i18n>Confirm}"
                type="Emphasized"
                press="onCloseOrderDialog"
            />
        </endButton>

    </Dialog>
</core:FragmentDefinition>
